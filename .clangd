If:
  PathMatch: (src|include)/.*
CompileFlags:
  Add: [-xc++, -std=c++98, --target=mipsel-unknown-elf, -nostdinc, -nostdinc++, -Wno-deprecated-writable-strings,
        -I../include, -I../include/std, -I../include/sce, -I../../include, -I../../include/std, -I../../include/sce]
Diagnostics:
  UnusedIncludes: None
Documentation:
  CommentFormat: Doxygen
