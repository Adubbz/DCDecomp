{
	"name": "Dev",
	"build": {
		"context": "..",
		"dockerfile": "../Dockerfile",
		"target": "dev"
	},
	"workspaceMount": "source=${localWorkspaceFolder},target=/dcdecomp,type=bind",
	"workspaceFolder": "/dcdecomp",
	"customizations": {
		"vscode": {
			"extensions": [
				"llvm-vs-code-extensions.vscode-clangd",
				"ms-python.black-formatter",
				"cschlosser.doxdocgen",
				"edwinhuish.better-comments-next"
			]
		}
	}
}