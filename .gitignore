# Build files
/build/
/build_pal/

# Reference assembly, split from the disc by splat and never committed: one
# tree per release, asm/ntsc and asm/pal, each with the static initialisers
# the build writes beside the split under reference/.
/asm/

# The PAL build's split of the overlay headers.
/assets/pal/

# A checkout of the private repository; see scripts/host/overlay_private.sh.
/.private/

# Generated by the objdiff target from the address index and provenance
objdiff.json

# The objdiff progress report, regenerated by CI on every push
progress/

/re/*
!/re/MWCC.md

# Doxygen output
doxygen/

# Python cache
**/__pycache__

# IDA files
*.id0
*.id1
*.id2
*.nam
*.til

# Mips2C context
ctx.c

# AI
CLAUDE.md
AGENTS.md
.claude
.codex/

# Permuting
permuting/

# IDA databases (derived from binaries already in-tree)
*.i64
*.idb

# splat scratch (the linker scripts it writes are not the ones this build uses)
/build/splat/

# The lock every build of the tree takes; see scripts/build/cmake.sh.
/.build.lock
