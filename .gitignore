# Build files
build/

# Generated by the objdiff target from the address index and provenance
objdiff.json

# The objdiff progress report, regenerated by CI on every push
progress/

# ref/ is deliberately NOT ignored: the reference disassembly is committed so
# that CI can build without the disc, which cannot be redistributed.
re/

# Python cache
**/__pycache__

# IDA files
*.id0
*.id1
*.id2
*.nam
*.til

# Mips2C context
ctx.c

# AI
CLAUDE.md
AGENTS.md

# Permuting
permuting/

# IDA databases (derived from binaries already in-tree)
*.i64
*.idb
