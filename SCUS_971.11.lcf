        itemdata.cpp.o (.data)
        main.data.part6.s.o (.data)
        stockitem.cpp.o (.data)
        . = . + 0xC;
        main.data.part7.s.o (.data)
        *(.data)
        *(.vudata)

        # rodata
        //
        // The wildcard first: every constant in .rodata proper belongs to a
        // translation unit and is supplied there, so the objects carry it and
        // link order puts it back where retail has it. What the dump still
        // holds is what comes after -- the static initialisers, the vtables
        // and the literal pool -- so its placement follows.
        *(.rodata)
        main.rdata.part1.s.o (.rdata)
        main.cpp.o (.init)
        . = . + 0x8;
        main.rdata.part2.s.o (.rdata)
        main.cpp.o (.ctor)
        main.rdata.part3.s.o (.rdata)
        camerafollow.cpp.o (.vtables)
        camera.cpp.o (.vtables)
        . = . + 0xC;
        main.rdata.part4.s.o (.rdata)
        character.cpp.o (.vtables)
        . = . + 0x8;
        main.rdata.part5.s.o (.rdata)
        mapobject.cpp.o (.vtables)
        savedata.cpp.o (.vtables)
        object.cpp.o (.vtables)
        . = . + 0xA0;
        main.rdata.part6.s.o (.rdata)
        mapparts.cpp.o (.vtables)
        hitmark.cpp.o (.vtables)
        main.rdata.part7.s.o (.rdata)
        *(.rdata)

		# C++ related sections

		# static initializers
		*(.init)
		// TODO: __static_init = .;
		*(.ctor)
		// TODO: __static_init_end = .;
		# vtable
		*(.vtables)
		# exception
		*(.exception)
		// TODO: __exception_table_start__ = .;
		EXCEPTION
		// TODO: __exception_table_end__ = .;

		# gp
        _gp	= 0x2A97F0;

		# Entries of retail's literal pool that a compiled unit loads from.
		# scripts/build/literals.py binds each float constant an object holds
		# to the entry retail loads it from. The assignments stay here in pool
		# order. A constant retail's pool
		# does not hold stays in its object and the LITERAL directive below
		# appends it to the pool instead, which moves the small data after it.
		_LIT_002A1800 = 0x002a1800;
		_LIT_002A1868 = 0x002a1868;
		_LIT_002A186C = 0x002a186c;
		_LIT_002A1870 = 0x002a1870;
		_LIT_002A1888 = 0x002a1888;
		_LIT_002A1894 = 0x002a1894;
		_LIT_002A18A0 = 0x002a18a0;
		_LIT_002A18BC = 0x002a18bc;
		_LIT_002A18C4 = 0x002a18c4;
		_LIT_002A18D0 = 0x002a18d0;
		_LIT_002A18E4 = 0x002a18e4;
		_LIT_002A18EC = 0x002a18ec;
		_LIT_002A18F0 = 0x002a18f0;
		_LIT_002A1908 = 0x002a1908;
		_LIT_002A1934 = 0x002a1934;
		_LIT_002A1944 = 0x002a1944;
		_LIT_002A1948 = 0x002a1948;
		_LIT_002A1A8C = 0x002a1a8c;
		_LIT_002A1AF8 = 0x002a1af8;
		_LIT_002A1BCC = 0x002a1bcc;
		_LIT_002A1BD0 = 0x002a1bd0;
		_LIT_002A1C50 = 0x002a1c50;
		_LIT_002A1D0C = 0x002a1d0c;
		_LIT_002A1D10 = 0x002a1d10;
		_LIT_002A1D1C = 0x002a1d1c;
		_LIT_002A1D20 = 0x002a1d20;
		_LIT_002A1D24 = 0x002a1d24;
		_LIT_002A1D98 = 0x002a1d98;
		_LIT_002A1D9C = 0x002a1d9c;
		_LIT_002A1DBC = 0x002a1dbc;
		_LIT_002A1DCC = 0x002a1dcc;
		_LIT_002A1DD0 = 0x002a1dd0;
		_LIT_002A1DD8 = 0x002a1dd8;
		// TODO: _gp	= . + 0x7ff0;

        _stack       = 0x01F80000;
        _stack_size  = 0x00080000;
        _align_segment = 0x00000080;

		# Retail resolves this to -1; the dun overlay's data references it.
		_heap_size   = 0xFFFFFFFF;

		# literal
		LITERAL

		# sdata
		main.sdata.part1.s.o (.sdata)
		mainselect.cpp.o (.sdata)
		main.cpp.o (.sdata)
		main.sdata.part2.s.o (.sdata)
		stockitem.cpp.o (.sdata)
		main.sdata.part3.s.o (.sdata)
		*(.sdata)

		# sbss
