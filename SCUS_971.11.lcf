        # rodata
        //
        // The wildcard first: every constant in .rodata proper belongs to a
        // translation unit and is supplied there, so the objects carry it and
        // link order puts it back where retail has it. What the dump still
        // holds is what comes after -- the static initialisers, the vtables
        // and the literal pool -- so its placement follows.
        *(.rodata)
        main.rdata.part1.s.o (.rdata)    // 0x0029fe80  __sinit_dataset.cpp
        mglib.cpp.o (.init)              // 0x0029ff40
        . = . + 0x4;                     // the four bytes this unit's own initialiser is short
        main.cpp.o (.init)               // 0x002a0050
        . = . + 0x8;
        main.rdata.part2.s.o (.rdata)    // 0x002a00b0
        monstorunit.cpp.o (.init)        // 0x002a0c60, retail monstor.cpp
        . = . + 0x4;                    // initializer payload is 0x3c, retail slot 0x40
        main.rdata.part2b.s.o (.rdata)   // 0x002a0ca0
        mglib.cpp.o (.ctor)              // 0x002a1014
        main.cpp.o (.ctor)               // 0x002a1018
        main.rdata.part3.s.o (.rdata)
