        savedata.cpp.o (.data)
        main.data.part4.s.o (.data)
        sysmes.cpp.o (.data)
        main.data.part4b.s.o (.data)
        edit.cpp.o (.data)
        main.data.part4c.s.o (.data)
        weaponelement.cpp.o (.data)  // 0x0026b2c0
        main.data.part4d.s.o (.data) // 0x0026b2e0
        dungeonmap.cpp.o (.data)
        main.data.part5.s.o (.data)
        itemdata.cpp.o (.data)
        main.data.part6.s.o (.data)
        weaponeffect.cpp.o (.data)   // 0x0027eb30
        main.data.part6c.s.o (.data) // 0x0027eb50
        weapon_buildup.cpp.o (.data) // 0x00295810
        main.data.part6d.s.o (.data) // 0x00295830
        weaponlevelup.cpp.o (.data)  // 0x00295840
        . = ALIGN(16);               // the tail of the unit's last template
        main.data.part6b.s.o (.data) // 0x002959a0
        stockitem.cpp.o (.data)
        . = . + 0xC;
        fish.cpp.o (.data)
        charakey.cpp.o (.data)
        main.data.part7b.s.o (.data)
        *(.data)
        *(.vudata)

        # rodata
        //
        // The wildcard first: every constant in .rodata proper belongs to a
        // translation unit and is supplied there, so the objects carry it and
        // link order puts it back where retail has it. What the dump still
        // holds is what comes after -- the static initialisers, the vtables
        // and the literal pool -- so its placement follows.
        *(.rodata)
        main.rdata.part1.s.o (.rdata)    // 0x0029fe80  __sinit_dataset.cpp
        mglib.cpp.o (.init)              // 0x0029ff40
        . = . + 0x4;                     // the four bytes this unit's own initialiser is short
        main.cpp.o (.init)               // 0x002a0050
        . = . + 0x8;
        main.rdata.part2.s.o (.rdata)    // 0x002a00b0
        mglib.cpp.o (.ctor)              // 0x002a1014
        main.cpp.o (.ctor)               // 0x002a1018
        main.rdata.part3.s.o (.rdata)
        camerafollow.cpp.o (.vtables)
        camera.cpp.o (.vtables)
        . = . + 0xC;
        collisionmdt.cpp.o (.vtables)    // 0x002a10d0
        . = ALIGN(16);
        dataset.cpp.o (.vtables)         // 0x002a1100
        . = ALIGN(16);
        frame.cpp.o (.vtables)           // 0x002a1130
        . = ALIGN(8);
        main.rdata.part4b.s.o (.rdata)   // 0x002a1168
        character.cpp.o (.vtables)       // 0x002a11e0
        . = . + 0x8;
        main.rdata.part5.s.o (.rdata)
        mapobject.cpp.o (.vtables)
        objectframe2.cpp.o (.vtables)
        savedata.cpp.o (.vtables)
        object.cpp.o (.vtables)
        main.rdata.part6.s.o (.rdata)
        mapparts.cpp.o (.vtables)
        hitmark.cpp.o (.vtables)
        main.rdata.part7.s.o (.rdata)
        *(.rdata)

		# C++ related sections

		# static initializers
		*(.init)
		// TODO: __static_init = .;
		*(.ctor)
		// TODO: __static_init_end = .;
		# vtable
		*(.vtables)
		# exception
		*(.exception)
		// TODO: __exception_table_start__ = .;
		EXCEPTION
		// TODO: __exception_table_end__ = .;

		# gp
        _gp	= 0x2A97F0;

		# The table of external characters that follows the Georama editor's
		# parts data. Retail reaches it by its own name, not as an offset into
		# EditPartsData, so the code carries a relocation against this address.
		EditGaijiTbl = 0x002589ec;

		# Entries of retail's literal pool that a compiled unit loads from.
		# scripts/build/literals.py binds each float constant an object holds
		# to the entry retail loads it from as a local absolute @N symbol in the
		# object. A constant retail's pool does not hold stays in its object and
		# the LITERAL directive below appends it to the pool instead, which moves
		# the small data after it.
		// TODO: _gp	= . + 0x7ff0;

        _stack       = 0x01F80000;
        _stack_size  = 0x00080000;
        _align_segment = 0x00000080;

		# Retail resolves this to -1; the dun overlay's data references it.
		_heap_size   = 0xFFFFFFFF;

		# literal
		LITERAL

		# sdata
		mathutil.cpp.o (.sdata)        // 0x002a1e80
		main.sdata.part1.s.o (.sdata)  // 0x002a1e88
		mainselect.cpp.o (.sdata)      // 0x002a1e8c
		main.cpp.o (.sdata)            // 0x002a1e90
		dataread.cpp.o (.sdata)        // 0x002a1e94
		main.sdata.part2.s.o (.sdata)  // 0x002a1e98
		clsmes.cpp.o (.sdata)          // 0x002a1ec0
		main.sdata.part2b.s.o (.sdata) // 0x002a1ed0
		ebattle_loop.cpp.o (.sdata)    // 0x002a1f14
		main.sdata.part2c.s.o (.sdata) // 0x002a1f18
		edit.cpp.o (.sdata)            // 0x002a1f24
		main.sdata.part2d.s.o (.sdata) // 0x002a1f50
		editloop.cpp.o (.sdata)        // 0x002a1f78
		main.sdata.part2f.s.o (.sdata) // 0x002a1f80
		weapon_buildup.cpp.o (.sdata)  // 0x002a21c8
		weaponlevelup.cpp.o (.sdata)   // 0x002a21d8
		main.sdata.part2e.s.o (.sdata) // 0x002a21f0
		stockitem.cpp.o (.sdata)

		// The title overlay's small data, reached through $gp like its small
		// bss, one run per object in link order.
		opening.cpp.o (.sdata)         // 0x002a2220
		op_a.cpp.o (.sdata)            // 0x002a2248
		op_b.cpp.o (.sdata)            // 0x002a2258
		op_c.cpp.o (.sdata)            // 0x002a2260
		op_d.cpp.o (.sdata)            // 0x002a2278
		title.cpp.o (.sdata)           // 0x002a2280
		titleloop.cpp.o (.sdata)
		sprite.cpp.o (.sdata)          // 0x002a22d8
		main.sdata.part3.s.o (.sdata)  // 0x002a22e0
		*(.sdata)

		# sbss
		_fbss = .;
		camera.cpp.o (.sbss)
		main.sbss.part1.s.o (.sbss)    // 0x002a2384
		dataset.cpp.o (.sbss)          // 0x002a2390
		. = ALIGN(4);
		gamepad.cpp.o (.sbss)          // 0x002a23a0
		// Retail rounds the end of a unit's small-bss run up to four bytes,
		// which the last static -- a one-byte flag here -- leaves short.
		. = ALIGN(4);
		mglib.cpp.o (.sbss)            // 0x002a23b0
		texture.cpp.o (.sbss)          // 0x002a2470
		. = ALIGN(4);
		character.cpp.o (.sbss)        // 0x002a2478
		chararead.cpp.o (.sbss)        // 0x002a247c
		dataread.cpp.o (.sbss)         // 0x002a24e4
		main.sbss.part3.s.o (.sbss)    // 0x002a24fc
		main.cpp.o (.sbss)
		main.sbss.part4.s.o (.sbss)
		clsmes.cpp.o (.sbss)
		gameutil.cpp.o (.sbss)         // 0x002a25a8
		main.sbss.part4b.s.o (.sbss)   // 0x002a25b8
		edit.cpp.o (.sbss)             // 0x002a2740
		main.sbss.part4c.s.o (.sbss)   // 0x002a27ac
		editloop3.cpp.o (.fadebss)     // 0x002a29f8
		main.sbss.part4d.s.o (.sbss)   // 0x002a2a04
		dungeonmap.cpp.o (.sbss)
		main.sbss.part5.s.o (.sbss)
		charakey.cpp.o (.sbss)
		. = ALIGN(4);
		main.sbss.part5b.s.o (.sbss)   // 0x002a2fd8

		// The title overlay's small data. Its units keep it in main's image
		// because it is reached through $gp, one contiguous run per object,
		// so the dump is cut into the runs the units leave between them.
		opening.cpp.o (.sbss)          // 0x002a2ff0
		op_a.cpp.o (.sbss)             // 0x002a30a4
		op_b.cpp.o (.sbss)             // 0x002a3194
		op_c.cpp.o (.sbss)             // 0x002a31c8
		op_d.cpp.o (.sbss)             // 0x002a3270
		// Retail rounds the end of the run up; op_d's last static is a
		// one-byte guard.
		. = ALIGN(4);
		main.sbss.part5d.s.o (.sbss)   // 0x002a33a0
		rushmovi.cpp.o (.sbss)         // 0x002a33a4
		title.cpp.o (.sbss)            // 0x002a340c
		titleloop.cpp.o (.sbss)

		// The dun overlay's own small data: its file-scope globals and the
		// statics of its functions, in one run to the end of retail's.
		gameloop.cpp.o (.sbss)         // 0x002a3460
		*(.sbss)
		*(.scommon)
		*(SCOMMON)

        # bss
		main.bss.part1.s.o (.bss)      // 0x002a3709
		mathutil.cpp.o (.bss)          // 0x002aa010  SinTable
		main.bss.part1b.s.o (.bss)     // 0x002ab010
		texture_data.cpp.o (.bss)      // 0x002ab030  TextureData
		water.cpp.o (.bss)             // 0x002ab040
		main.bss.part2.s.o (.bss)      // 0x002ab050
		gamepad.cpp.o (.padbss)
		mglib.cpp.o (.bss)             // 0x01c751c0, with TexManager at 0x01c75870
		main.bss.part3.s.o (.bss)      // 0x01c7a6b8
		mglib.cpp.o (.mgbss2)          // 0x01c7a6c0
		texture.cpp.o (.bss)           // 0x01c7a830  texData
		chararead.cpp.o (.bss)         // 0x01c7ae70
		dataread.cpp.o (.bss)          // 0x01c7b0c0  header_buff, bg_read_info
		mainselect.cpp.o (.bss)
		gamepad.cpp.o (.bss)
		main.cpp.o (.bss)
		main.bss.part4.s.o (.bss)      // 0x01ce7570
		gameutil.cpp.o (.bss)          // 0x01cece80
		main.bss.part4d.s.o (.bss)     // 0x01cecf00
		clsmes.cpp.o (.bss)
		main.bss.part4b.s.o (.bss)     // 0x01cf91f0
		edit.cpp.o (.bss)              // 0x01d19720
		main.bss.part4c.s.o (.bss)     // 0x01d19aa0
		editpartsinfo.cpp.o (.bss)
		main.bss.part5.s.o (.bss)      // 0x01d1b218
		editloop3.cpp.o (.fadecolbss)  // 0x01d3d1c0
		main.bss.part5b.s.o (.bss)     // 0x01d3d1d0
		dungeonmap.cpp.o (.bss)
		main.bss.part6.s.o (.bss)
		*(.bss)
		*(.common)
		*(COMMON)
		*(.vubss)

		# end of main segment
		. = ALIGN(128);
    } > main


    .heap:
    {
        . = ALIGN(16);
    } > heap
}
