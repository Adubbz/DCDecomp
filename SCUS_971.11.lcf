        *(.text)
        ALIGNALL(1); // Perform no additional alignment
        *(.vutext)

        # data
        main.data.part1.s.o (.data)
        character.cpp.o (.data)
        main.data.part2.s.o (.data)
        mapobject.cpp.o (.data)
        main.data.part3.s.o (.data)
