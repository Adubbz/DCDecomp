        *(.vutext)

        # data
        //
        // Retail's .data is one run per translation unit, in the order the
        // units link. A unit that is decompiled supplies its own run and the
        // residual dump is carved around it.
        main.data.part1.s.o (.data)
        frame.cpp.o (.data)
        mglib.cpp.o (.data)
        texture.cpp.o (.data)
        visualvu1.cpp.o (.data)
        main.data.part1b.s.o (.data)
